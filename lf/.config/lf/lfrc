set period 1
set info size
set dircounts

map p : paste; clear

map a push %touch<space>
map d push %mkdir<space>

cmd trash %set -f; mkdir -p ~/.trash && mv -t ~/.trash -- $fx
map D trash

set shell zsh
map Q %lf -remote "send $id :cd \"$lf_user_OLDPWD\"; quit"
&lf -remote "send $id set user_OLDPWD \"$PWD\""

